# ========================================================
# Klip. URL Shortener Environment Configuration Template
# ========================================================

# [Server] Port for Express API server
PORT=5000

# [Server] Public Base URL used to build short links (${BASE_URL}/${shortCode})
BASE_URL=http://localhost:3000

# [Server] PostgreSQL Connection String (Neon, Supabase, Railway, Render, etc.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/url_shortener

# [Server] Allowed Client Origin for CORS
CLIENT_ORIGIN=http://localhost:3000

# [Client] Backend API URL for React client (Create React App / Vite)
REACT_APP_API_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000

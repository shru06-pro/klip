{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "Fullstack URL Shortener built with React and PostgreSQL",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run server\" \"npm run client\"",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run server:dev\" \"npm run client\"",
    "client": "npm start --prefix client",
    "server": "npm start --prefix server",
    "server:dev": "npm run dev --prefix server",
    "install:all": "npm install && npm install --prefix client && npm install --prefix server",
    "build:client": "npm run build --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

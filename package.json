{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "Fullstack URL Shortener built with React and PostgreSQL",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run backend\" \"npm run frontend\"",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run backend:dev\" \"npm run frontend\"",
    "frontend": "npm start --prefix frontend",
    "backend": "npm start --prefix backend",
    "backend:dev": "npm run dev --prefix backend",
    "client": "npm run frontend",
    "server": "npm run backend",
    "server:dev": "npm run backend:dev",
    "install:all": "npm install && npm install --prefix frontend && npm install --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:client": "npm run build:frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

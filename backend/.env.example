# Backend Server Port
PORT=5000

# Public Base URL used to generate short URLs (Never leave empty in production)
BASE_URL=http://localhost:3000

# PostgreSQL Database Connection String (from Neon, Supabase, Railway, Render, etc.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/url_shortener

# Allowed Frontend Origin for CORS (comma-separated if multiple)
CLIENT_ORIGIN=http://localhost:3000
